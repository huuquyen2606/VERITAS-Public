# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions & build artifacts
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
/venv/
.venv/
func_venv/
**/func_venv/
env.bak/
venv.bak/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.agents/
.codex/
.review/

# Logs and runtime traces
*.log
**/logs/*.log
**/*.log

# Datasets and Large Binary Files (> 100MB)
data/dataset/Adv_agent/*
data/dataset/Test/*
!data/dataset/**/.gitkeep
data/precomputed/train/*
data/precomputed/test/*
!data/precomputed/**/.gitkeep
data/benign_content/*
!data/benign_content/**/.gitkeep
*.rar
*.7z
*.zip
*.tar.xz
*.tar.gz

# Uncompressed surrogate weights (>100MB)
**/weights/m_attn_health_multi.pth
!**/weights/m_attn_health_multi.pth.xz
